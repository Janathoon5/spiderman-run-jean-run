# Roblox / Rojo
# Place files are binary and generally not tracked...
*.rbxl
*.rbxlx
# Studio writes a .lock beside the open place file — never track these.
*.rbxl.lock
*.rbxlx.lock
# ...except the place file itself, which is the map's source of truth.
!place/*.rbxl

# Generated by Luau LSP / rojo sourcemap
sourcemap.json

# Editor / OS
# Project-level editor config IS shared; personal settings are not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
